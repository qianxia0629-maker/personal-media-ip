# 火山引擎 语音合成（豆包 TTS）凭证，二选一
# 新版控制台：API Key
VOLC_TTS_API_KEY=
# 旧版控制台：App ID + Access Token
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=

# 资源 ID（默认 seed-tts-1.0；2.0 音色按控制台提示填写）
VOLC_TTS_RESOURCE_ID=seed-tts-1.0
# 音色 ID，在火山音色广场复制；文章里用的是 2.0 系列沉稳男声
VOLC_TTS_VOICE=zh_male_liufei_uranus_bigtts
# 语速，20 ≈ 1.2 倍速（tts-s20.mjs 会强制设为 20）
VOLC_TTS_SPEED=20
